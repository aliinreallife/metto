# Holiday sync (timestamp.ir -> Upstash Redis -> timetable selection)
# Never commit real values. Set these in Vercel Project Settings -> Environment Variables.

# Server-side timestamp.ir key (sent as X-API-Key header, never to the browser).
TIMESTAMP_IR_API_KEY=

# Protects /api/cron/sync-holidays (Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=

# Auto-provided by the Vercel Marketplace Upstash Redis integration, which
# exposes KV_-prefixed names. Either pair works (UPSTASH_* takes precedence):
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, or
#   KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative names auto-provided by the same integration (also accepted):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
