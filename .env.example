# Holiday sync (timestamp.ir -> Upstash Redis -> timetable selection)
# Never commit real values. Set these in Vercel Project Settings -> Environment Variables.

# Server-side timestamp.ir key (sent as X-API-Key header, never to the browser).
TIMESTAMP_IR_API_KEY=

# Protects /api/cron/sync-holidays (Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=

# Auto-provided by the Vercel Marketplace Upstash Redis integration.
# The same store shares the pedestrian routing quota budget across instances.
# The integration exposes KV_-prefixed names. Either pair works (UPSTASH_* takes precedence):
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, or
#   KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative names auto-provided by the same integration (also accepted):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# CARTO basemap key for the Minimalist map mode (client-side tile requests).
# Never commit a real value. Local dev: put it in `.env.local` (git-ignored).
# Deployments (e.g. Vercel): set it as an Environment Variable with the same name.
# This key is intentionally browser-visible (NEXT_PUBLIC_*); it keeps the key
# out of the repo, it does not make a client-side key secret.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=

# Server-only pedestrian routing key from openrouteservice.org.
# Directions are requested from api.heigit.org (the new API hostname).
# Without it, cached walking paths still work and new walks are approximate.
OPENROUTESERVICE_API_KEY=

# Mashhad Lines 1/2 stations/routes are live. Set to 0 to disable the city.
# Rebuild/redeploy after changing this setting (city pages are prerendered).
METTO_MASHHAD_ENABLED=

# Public contribution form. The Vercel backend accepts reports without sign-in.
# Unset keeps the GitHub issue link. This is a public URL, never a secret.
# NEXT_PUBLIC_DATA_CONTRIBUTIONS_URL=https://data.metto.ir/contribute
