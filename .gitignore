# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
.vercel

# TypeScript incremental build info (local only)
tsconfig.tsbuildinfo

# Agent working notes (local only)
.mimocode/

# Serwist (generated service worker; source is app/sw.ts)
public/sw.js
public/sw.js.map
public/sw.js.map.txt

# Playwright
test-results/
playwright-report/
# Playwright bypass-cookie state (may hold a Vercel bypass grant)
playwright/.auth/

# Android TWA (see docs/ANDROID_TWA.md). The generated wrapper under
# android/ IS committed (twa-manifest.json, Gradle project, manifests,
# resources). Only secrets, local SDK paths, caches and outputs are ignored.
*.jks
*.keystore
android/keystore.properties
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/release/
